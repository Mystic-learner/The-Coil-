// === INPUT: Keyboard + Swipe + On-Screen Arrows ===
const keyMap = {
  up: ["arrowup", "d"],
  down: ["arrowdown", "x"],
  left: ["arrowleft", "z"],
  right: ["arrowright", "c"]
};

// === Keyboard Controls ===
document.addEventListener("keydown", e => {
  const k = e.key.toLowerCase();
  if (k === "p") return togglePause();
  if (k === "r") return resetGame();

  if (keyMap.up.includes(k) && velocity.y === 0) nextDir = { x: 0, y: -1 };
  if (keyMap.down.includes(k) && velocity.y === 0) nextDir = { x: 0, y: 1 };
  if (keyMap.left.includes(k) && velocity.x === 0) nextDir = { x: -1, y: 0 };
  if (keyMap.right.includes(k) && velocity.x === 0) nextDir = { x: 1, y: 0 };

  if (bgm.paused) bgm.play().catch(() => {});
});

// === Swipe Controls (for mobile gesture input) ===
let touchStartX = 0, touchStartY = 0, touchEndX = 0, touchEndY = 0;

document.addEventListener("touchmove", e => e.preventDefault(), { passive: false });

document.addEventListener("touchstart", e => {
  const touch = e.touches[0];
  touchStartX = touch.clientX;
  touchStartY = touch.clientY;
});

document.addEventListener("touchmove", e => {
  const touch = e.touches[0];
  touchEndX = touch.clientX;
  touchEndY = touch.clientY;
});

document.addEventListener("touchend", () => {
  const dx = touchEndX - touchStartX;
  const dy = touchEndY - touchStartY;
  const absX = Math.abs(dx);
  const absY = Math.abs(dy);

  if (Math.max(absX, absY) < 25) return;

  if (absX > absY) {
    if (dx > 0 && velocity.x === 0) nextDir = { x: 1, y: 0 };
    else if (dx < 0 && velocity.x === 0) nextDir = { x: -1, y: 0 };
  } else {
    if (dy > 0 && velocity.y === 0) nextDir = { x: 0, y: 1 };
    else if (dy < 0 && velocity.y === 0) nextDir = { x: 0, y: -1 };
  }
});

// === ON-SCREEN ARROW CONTROLS (MOBILE) ===
function setupArrowControls() {
  const up = document.getElementById("up");
  const down = document.getElementById("down");
  const left = document.getElementById("left");
  const right = document.getElementById("right");

  if (!up || !down || !left || !right) return;

  const move = dir => {
    switch (dir) {
      case "up":
        if (velocity.y === 0) nextDir = { x: 0, y: -1 };
        break;
      case "down":
        if (velocity.y === 0) nextDir = { x: 0, y: 1 };
        break;
      case "left":
        if (velocity.x === 0) nextDir = { x: -1, y: 0 };
        break;
      case "right":
        if (velocity.x === 0) nextDir = { x: 1, y: 0 };
        break;
    }
  };

  // Add both click (desktop) and touchstart (mobile)
  up.addEventListener("click", () => move("up"));
  down.addEventListener("click", () => move("down"));
  left.addEventListener("click", () => move("left"));
  right.addEventListener("click", () => move("right"));

  up.addEventListener("touchstart", e => { e.preventDefault(); move("up"); });
  down.addEventListener("touchstart", e => { e.preventDefault(); move("down"); });
  left.addEventListener("touchstart", e => { e.preventDefault(); move("left"); });
  right.addEventListener("touchstart", e => { e.preventDefault(); move("right"); });
}

setupArrowControls();
